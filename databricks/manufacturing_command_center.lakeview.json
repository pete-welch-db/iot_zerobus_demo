{
  "datasets": [
    {
      "name": "ds_live_telemetry",
      "displayName": "Live Telemetry",
      "queryLines": [
        "SELECT event_time, machine_id, state, temp_c, vibration_mm_s, throughput_cpm, rpm, current_amps, humidity_pct FROM welch.iot_demo_dev.vw_machine_telemetry_live"
      ]
    },
    {
      "name": "ds_health_window",
      "displayName": "Health by Window",
      "queryLines": [
        "SELECT machine_id, window_end, oee_pct, availability_pct, performance_pct, quality_pct, anomaly_score, prob_fault_next_5m, avg_rpm, avg_current_amps, avg_humidity_pct, time_in_run_s, time_in_stopped_s, time_in_fault_s FROM welch.iot_demo_dev.vw_machine_health"
      ]
    },
    {
      "name": "ds_current_status",
      "displayName": "Current Status",
      "queryLines": [
        "SELECT machine_id, state, last_event_time, oee_pct, anomaly_score, prob_fault_next_5m, throughput_cpm, temp_c, vibration_mm_s, rpm, current_amps, humidity_pct, telemetry_lag_seconds, ml_lag_seconds FROM welch.iot_demo_dev.vw_machine_current_status"
      ]
    },
    {
      "name": "ds_device_health_latency",
      "displayName": "Device Health + Latency",
      "queryLines": [
        "SELECT s.machine_id, d.line_name, s.state, s.last_event_time, s.telemetry_lag_seconds, s.ml_lag_seconds, s.temp_c, s.vibration_mm_s, s.throughput_cpm, s.rpm, s.current_amps, s.humidity_pct, s.anomaly_score, s.prob_fault_next_5m, CASE WHEN s.prob_fault_next_5m >= 0.7 THEN 'HIGH' WHEN s.prob_fault_next_5m >= 0.4 THEN 'MEDIUM' ELSE 'LOW' END AS fault_band FROM welch.iot_demo_dev.vw_machine_current_status s LEFT JOIN welch.iot_demo_dev.dim_machine d ON s.machine_id = d.machine_id"
      ]
    },
    {
      "name": "ds_downtime",
      "displayName": "Downtime by Window",
      "queryLines": [
        "SELECT machine_id, window_end, (time_in_stopped_s + time_in_fault_s) AS downtime_s FROM welch.iot_demo_dev.vw_machine_health"
      ]
    }
  ],
