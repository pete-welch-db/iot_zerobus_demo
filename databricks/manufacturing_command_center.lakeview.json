{
  "datasets": [
    {
      "name": "ds_filter_machine",
      "displayName": "Filter Machine",
      "queryLines": [
        "SELECT DISTINCT machine_id FROM welch.iot_demo_dev.vw_machine_current_status ORDER BY machine_id"
      ]
    },
    {
      "name": "ds_filter_state",
      "displayName": "Filter State",
      "queryLines": [
        "SELECT DISTINCT state FROM welch.iot_demo_dev.vw_machine_telemetry_live ORDER BY state"
      ]
    },
    {
      "name": "ds_live_telemetry",
      "displayName": "Live Telemetry",
      "queryLines": [
        "SELECT event_time, machine_id, state, temp_c, vibration_mm_s, throughput_cpm FROM welch.iot_demo_dev.vw_machine_telemetry_live"
      ]
    },
    {
      "name": "ds_health_window",
      "displayName": "Health by Window",
      "queryLines": [
        "SELECT machine_id, window_end, oee_pct, availability_pct, performance_pct, quality_pct, anomaly_score, prob_fault_next_5m FROM welch.iot_demo_dev.vw_machine_health"
      ]
    },
    {
      "name": "ds_current_status",
      "displayName": "Current Status",
      "queryLines": [
        "SELECT machine_id, state, last_event_time, oee_pct, anomaly_score, prob_fault_next_5m, throughput_cpm, temp_c, vibration_mm_s, telemetry_lag_seconds, ml_lag_seconds FROM welch.iot_demo_dev.vw_machine_current_status"
      ]
    },
    {
      "name": "ds_downtime",
      "displayName": "Downtime by Window",
      "queryLines": [
        "SELECT machine_id, window_end, (time_in_stopped_s + time_in_fault_s) AS downtime_s FROM welch.iot_demo_dev.vw_machine_health"
      ]
    }
  ],
  "pages": [
    {
      "name": "manufacturing_command_center",
      "displayName": "Manufacturing Command Center",
      "layoutVersion": "GRID_V1",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "header",
            "multilineTextboxSpec": {
              "lines": [
                "# Manufacturing Command Center",
                "**Real-time operations, risk, and OEE**"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "filter_machine",
            "queries": [
              {
                "name": "machine_0_q",
                "query": {
                  "datasetName": "ds_live_telemetry",
                  "fields": [
                    {
                      "name": "machine_id",
                      "expression": "`machine_id`"
                    }
                  ],
                  "disaggregated": true
                }
              },
              {
                "name": "machine_1_q",
                "query": {
                  "datasetName": "ds_health_window",
                  "fields": [
                    {
                      "name": "machine_id",
                      "expression": "`machine_id`"
                    }
                  ],
                  "disaggregated": true
                }
              },
              {
                "name": "machine_2_q",
                "query": {
                  "datasetName": "ds_current_status",
                  "fields": [
                    {
                      "name": "machine_id",
                      "expression": "`machine_id`"
                    }
                  ],
                  "disaggregated": true
                }
              },
              {
                "name": "machine_3_q",
                "query": {
                  "datasetName": "ds_downtime",
                  "fields": [
                    {
                      "name": "machine_id",
                      "expression": "`machine_id`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "machine_id",
                    "displayName": "Machine",
                    "queryName": "machine_0_q"
                  },
                  {
                    "fieldName": "machine_id",
                    "displayName": "Machine",
                    "queryName": "machine_1_q"
                  },
                  {
                    "fieldName": "machine_id",
                    "displayName": "Machine",
                    "queryName": "machine_2_q"
                  },
                  {
                    "fieldName": "machine_id",
                    "displayName": "Machine",
                    "queryName": "machine_3_q"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Machine"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 3,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "filter_state",
            "queries": [
              {
                "name": "state_0_q",
                "query": {
                  "datasetName": "ds_live_telemetry",
                  "fields": [
                    {
                      "name": "state",
                      "expression": "`state`"
                    }
                  ],
                  "disaggregated": true
                }
              },
              {
                "name": "state_1_q",
