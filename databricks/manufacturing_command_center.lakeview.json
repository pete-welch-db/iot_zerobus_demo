              "encodings": {
                "fields": [
                  {
                    "fieldName": "state",
                    "displayName": "State",
                    "queryName": "state_0_q"
                  },
                  {
                    "fieldName": "state",
                    "displayName": "State",
                    "queryName": "state_1_q"
