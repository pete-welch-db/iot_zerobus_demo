{
  "datasets": [
    {
      "name": "ds_current_status",
      "displayName": "Current Status",
      "queryLines": [
        "SELECT machine_id, state, last_event_time, DATE_TRUNC('HOUR', last_event_time) AS last_event_hour, oee_pct, anomaly_score, prob_fault_next_5m, prob_fault_next_1h, prob_fault_next_24h, prob_fault_next_7d, telemetry_lag_ms, ml_lag_ms, temp_c, vibration_mm_s, throughput_cpm, rpm, current_amps, humidity_pct, load_pct, power_kw, power_factor, voltage_v, pressure_bar, flow_rate_lpm FROM welch.iot_demo_dev.vw_machine_current_status"
      ]
    },
    {
      "name": "ds_live_telemetry",
      "displayName": "Live Telemetry",
      "queryLines": [
        "SELECT event_time, DATE_TRUNC('HOUR', event_time) AS event_hour, machine_id, state, temp_c, vibration_mm_s, rpm, current_amps, humidity_pct, throughput_cpm FROM welch.iot_demo_dev.vw_machine_telemetry_live"
      ]
    },
    {
      "name": "ds_health_window",
      "displayName": "Health by Window",
      "queryLines": [
        "SELECT machine_id, window_end, DATE_TRUNC('HOUR', window_end) AS window_hour, oee_pct, availability_pct, performance_pct, quality_pct, time_in_run_s, time_in_stopped_s, time_in_fault_s, anomaly_score, prob_fault_next_5m, prob_fault_next_1h, prob_fault_next_24h, prob_fault_next_7d FROM welch.iot_demo_dev.vw_machine_health"
      ]
    },
    {
      "name": "ds_device_drilldown",
      "displayName": "Device Drill-Down",
      "queryLines": [
        "SELECT s.machine_id, d.line_name, s.state, s.last_event_time, DATE_TRUNC('HOUR', s.last_event_time) AS last_event_hour, s.telemetry_lag_ms, s.ml_lag_ms, s.temp_c, s.vibration_mm_s, s.throughput_cpm, s.rpm, s.current_amps, s.humidity_pct, s.load_pct, s.power_kw, s.power_factor, s.voltage_v, s.pressure_bar, s.flow_rate_lpm, s.oee_pct, s.anomaly_score, s.prob_fault_next_5m, s.prob_fault_next_1h, s.prob_fault_next_24h, s.prob_fault_next_7d FROM welch.iot_demo_dev.vw_machine_current_status s LEFT JOIN welch.iot_demo_dev.dim_machine d ON s.machine_id = d.machine_id"
      ]
    },
    {
      "name": "ds_metric_oee",
      "displayName": "Metric OEE",
      "queryLines": [
        "SELECT `Machine` AS machine_id, `Window Hour` AS window_hour, MEASURE(`OEE Pct`) AS oee_pct, MEASURE(`Availability Pct`) AS availability_pct, MEASURE(`Performance Pct`) AS performance_pct, MEASURE(`Quality Pct`) AS quality_pct FROM welch.iot_demo_dev.mv_machine_oee GROUP BY ALL"
      ]
    },
    {
      "name": "ds_metric_risk",
      "displayName": "Metric Risk",
      "queryLines": [
        "SELECT `Machine` AS machine_id, `Window Date` AS window_date, MEASURE(`Avg Fault Risk 5m`) AS risk_5m, MEASURE(`Avg Fault Risk 1h`) AS risk_1h, MEASURE(`Avg Fault Risk 24h`) AS risk_24h, MEASURE(`Avg Fault Risk 7d`) AS risk_7d, MEASURE(`High Risk Windows`) AS high_risk_windows FROM welch.iot_demo_dev.mv_machine_risk GROUP BY ALL"
      ]
    },
    {
      "name": "ds_metric_freshness",
      "displayName": "Metric Freshness",
      "queryLines": [
        "SELECT `Machine` AS machine_id, MEASURE(`Avg Telemetry Lag Ms`) AS avg_telemetry_lag_ms, MEASURE(`Avg ML Lag Ms`) AS avg_ml_lag_ms, MEASURE(`Max Telemetry Lag Ms`) AS max_telemetry_lag_ms, MEASURE(`Max ML Lag Ms`) AS max_ml_lag_ms FROM welch.iot_demo_dev.mv_machine_freshness GROUP BY ALL"
      ]
    },
    {
      "name": "ds_latency_monitor",
      "displayName": "Latency Monitor",
      "queryLines": [
        "SELECT machine_id, telemetry_lag_ms, ml_lag_ms, CASE WHEN telemetry_lag_ms < 10000 THEN '✓ <10s' WHEN telemetry_lag_ms < 30000 THEN '⚠ 10-30s' ELSE '✗ >30s' END AS latency_status FROM welch.iot_demo_dev.vw_machine_current_status"
      ]
    }
  ],
