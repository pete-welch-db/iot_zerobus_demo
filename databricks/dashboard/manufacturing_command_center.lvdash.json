        {
          "widget": {
            "name": "device_health_latency_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_device_drilldown",
                  "fields": [
                    { "name": "machine_id", "expression": "`machine_id`" },
                    { "name": "line_name", "expression": "`line_name`" },
                    { "name": "state", "expression": "`state`" },
                    { "name": "last_event_time", "expression": "`last_event_time`" },
                    { "name": "telemetry_lag_ms", "expression": "`telemetry_lag_ms`" },
                    { "name": "ml_lag_ms", "expression": "`ml_lag_ms`" },
                    { "name": "oee_pct", "expression": "`oee_pct`" },
                    { "name": "anomaly_score", "expression": "`anomaly_score`" },
                    { "name": "prob_fault_next_5m", "expression": "`prob_fault_next_5m`" },
                    { "name": "prob_fault_next_1h", "expression": "`prob_fault_next_1h`" },
                    { "name": "prob_fault_next_24h", "expression": "`prob_fault_next_24h`" },
                    { "name": "prob_fault_next_7d", "expression": "`prob_fault_next_7d`" },
                    { "name": "temp_c", "expression": "`temp_c`" },
                    { "name": "vibration_mm_s", "expression": "`vibration_mm_s`" },
                    { "name": "rpm", "expression": "`rpm`" },
                    { "name": "current_amps", "expression": "`current_amps`" },
                    { "name": "humidity_pct", "expression": "`humidity_pct`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "machine_id", "displayName": "Machine" },
                  { "fieldName": "line_name", "displayName": "Line" },
                  { "fieldName": "state", "displayName": "State" },
                  { "fieldName": "last_event_time", "displayName": "Last Event" },
                  { "fieldName": "telemetry_lag_ms", "displayName": "Telemetry Lag (ms)" },
                  { "fieldName": "ml_lag_ms", "displayName": "ML Lag (ms)" },
                  { "fieldName": "oee_pct", "displayName": "OEE %" },
